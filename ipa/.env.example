# Invoice Pro Middleware API (System 2) — port 3001
PORT=3001
NODE_ENV=development

# Local dev — SQLite (set SKIP_ORACLE=true or omit Oracle wallet)
SKIP_ORACLE=true
DB_PATH=./data/invoicepro.db

# Oracle Autonomous Database — INVOICEPRO schema (production)
ORACLE_WALLET_PATH=../Oracle/wallet
ORACLE_USER_INVOICEPRO=invoicepro_user
ORACLE_PASS_INVOICEPRO=
ORACLE_DSN=pvedatabase_high

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# CORS (comma-separated origins, empty = allow all in dev)
CORS_ORIGINS=

# Firebase Admin (optional — for /api/superadmin/diagnostic)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
