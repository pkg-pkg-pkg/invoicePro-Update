{
  "name": "gst-billing-software",
  "version": "1.0.0",
  "description": "Complete GST Billing Software with Desktop and Mobile Applications",
  "private": true,
  "workspaces": [
    "desktop",
    "mobile",
    "backend",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:desktop && npm run install:mobile && npm run install:backend",
    "install:desktop": "cd desktop && npm install",
    "install:mobile": "cd mobile && npm install",
    "install:backend": "cd backend && npm install",
    "dev:desktop": "cd desktop && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "dev:backend": "cd backend && npm run dev",
    "build:desktop": "cd desktop && npm run build",
    "build:mobile": "cd mobile && npm run build",
    "build:backend": "cd backend && npm run build"
  },
  "keywords": [
    "gst",
    "billing",
    "inventory",
    "accounting",
    "retail"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron-rebuild": "^3.2.9"
  }
}
