    `).join(""),C=`
      @media print {
        @page { size: ${l.pageSize}; margin: 15mm; }
        body { margin: 0; }
      }
      * { box-sizing: border-box; }
      body { font-family: ${l.fontFamily}, sans-serif; font-size: ${l.fontSize}px; color: black; line-height: 1.5; margin: 0; padding: 20px; }
      .invoice-container { max-width: ${l.pageSize==="A4"?"210mm":"216mm"}; margin: 0 auto; position: relative; }
      .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 3px solid ${l.primaryColor}; }
      .company-info { flex: 1; }
      .company-name { font-size: 24px; font-weight: bold; color: ${l.primaryColor}; margin: 0 0 10px 0; }
      .company-details { font-size: 12px; line-height: 1.6; }
      .invoice-title { text-align: right; background: ${l.primaryColor}; color: white; padding: 15px 25px; border-radius: 5px; }
      .invoice-title h1 { margin: 0; font-size: 32px; font-weight: bold; }
      .invoice-number { font-size: 14px; margin-top: 5px; }
      .info-section { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0; }
      .info-box { background: ${l.secondaryColor}; padding: 15px; border-radius: 5px; border: 1px solid #ddd; }
      .info-box h3 { margin: 0 0 10px 0; color: ${l.primaryColor}; font-size: 14px; text-transform: uppercase; font-weight: bold; }
      .info-box p { margin: 5px 0; font-size: 13px; }
      table { width: 100%; border-collapse: collapse; margin: 20px 0; }
      th { background: ${l.primaryColor}; color: white; padding: 10px; text-align: left; font-weight: bold; font-size: 13px; }
      td { padding: 10px; border-bottom: 1px solid #ddd; font-size: 12px; }
      tbody tr:nth-child(even) { background: ${l.secondaryColor}; }
      .text-right { text-align: right; }
      .totals-section { margin: 20px 0; display: flex; justify-content: flex-end; }
      .totals-table { width: 300px; border: 2px solid #ddd; }
      .totals-table td { padding: 10px; font-size: 13px; }
      .totals-table tr { border-bottom: 1px solid #ddd; }
      .grand-total { background: ${l.primaryColor}; color: white; font-weight: bold; font-size: 16px; }
      .amount-words { background: #fff9e6; padding: 12px; border-left: 4px solid ${l.primaryColor}; margin: 15px 0; font-weight: 500; }
