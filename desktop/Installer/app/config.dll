${S}`;window.location.href=`mailto:${Xn.customer.email}?subject=${encodeURIComponent(_)}&body=${encodeURIComponent(C)}`},M=()=>{const S=String(f.name||"").trim()||"Your Company",_=Xn.items.map((F,V)=>`
