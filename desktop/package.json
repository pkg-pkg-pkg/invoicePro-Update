{
  "name": "@gst-billing/desktop",
  "version": "3.5.6",
  "description": "PVE InvoicePro 360 - desktop GST billing",
  "author": "PVE",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkg-pkg-pkg/invoicePro-Update.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "cross-env NODE_ENV=production VITE_ENV=production tsc && vite build",
    "build:ui": "tsc && vite build",
    "build:win": "npm run electron:kill && cross-env NODE_ENV=production VITE_ENV=production tsc && vite build && npm run build:icons && node scripts/prepare-electron-release.cjs && node scripts/run-electron-builder-win.cjs",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron": "cross-env NODE_ENV=production electron .",
    "electron:kill": "node scripts/kill-stale-electron.cjs",
    "electron:dev": "node scripts/kill-stale-electron.cjs && cross-env NODE_ENV=development concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:icons": "node scripts/build-app-icon.cjs && node scripts/build-nsis-assets.cjs",
    "dist": "npm run build:prod && npm run build:icons && electron-builder",
    "dist:dir": "npm run build:prod && npm run build:icons && electron-builder --dir",
    "dist:publish": "npm run build:prod && npm run build:icons && electron-builder --publish always",
    "release:github": "node scripts/publish-github-release.cjs",
    "test": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@tauri-apps/api": "^2.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "firebase": "^12.8.0",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "localtunnel": "^2.0.2",
    "node-machine-id": "^1.1.12",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "date-fns": "^2.30.0",
    "electron": "40.0.0",
    "electron-builder": "^23.0.6",
    "electron-rebuild": "2.0.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "ts-node": "^1.7.1",
    "typescript": "^5.3.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.16",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "undici": "^6.21.2"
  }
}
