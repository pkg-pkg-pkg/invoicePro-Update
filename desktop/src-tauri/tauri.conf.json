{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PVE InvoicePro 360",
  "version": "3.2.3",
  "identifier": "com.pve.invoicepro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PVE InvoicePro 360",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "PVE InvoicePro 360",
        "url": "/splashscreen.html",
        "width": 520,
        "height": 360,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBQzFDMzc0REQyNkFBMzYKUldRMnFpYmRkTVBCU3VTdFZIYXNHSklHbXB0OUNtN1JDOS83WGFyaWxDUHc5aHBEMkg4cDl5Qy8K",
      "endpoints": [
        "https://github.com/pkg-pkg-pkg/invoicePro-Update/releases/latest/download/latest.json"
      ]
    }
  }
}
