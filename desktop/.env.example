# Desktop App Configuration
# Required for production builds (npm run build / build:win):
VITE_API_URL=http://localhost:3000/api
VITE_BACKEND_PORT=3000
VITE_ENV=development

# Firebase — invoicepro-105ba (https://console.firebase.google.com/project/invoicepro-105ba/overview)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=invoicepro-105ba.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=invoicepro-105ba
VITE_FIREBASE_STORAGE_BUCKET=invoicepro-105ba.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Security / Backend hardening
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_64_CHAR_SECRET
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=600

# License signing hardening
LICENSE_MASTER_SECRET=REPLACE_WITH_STRONG_RANDOM_64_CHAR_SECRET
LICENSE_TOKEN_TTL_MIN=30